# Generate a 32-byte key: openssl rand -hex 32
AUTH_JWT_SECRET=
# Exact public origin; HTTPS is mandatory when NODE_ENV=production.
APP_ORIGIN=http://localhost:3000
# Required in production. Generate independently: openssl rand -hex 32
# Existing plaintext databases must be migrated with npm run db:encrypt first.
DATABASE_ENCRYPTION_KEY=
PAYROLL_DB=data/payroll.sqlite

# Shared upload review and workspace chatbot: install Ollama and models first.
AI_DOCUMENTS_ENABLED=false
# Free local inference; chat and upload review do not use OpenAI.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
# Optional OCR executable paths; defaults resolve through the server PATH.
# Install Tesseract with English data and Poppler for image/scanned-PDF recognition.
# TESSERACT_PATH=/opt/homebrew/bin/tesseract
# PDFINFO_PATH=/opt/homebrew/bin/pdfinfo
# PDFTOPPM_PATH=/opt/homebrew/bin/pdftoppm
# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
# Secure uploads: connect Google Drive inside the existing HR document section.
FILE_UPLOADS_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Separate key: openssl rand -hex 32. Keep it out of Git and backed up securely.
DRIVE_TOKEN_SECRET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Optional future external vector service; document Q&A currently uses encrypted SQLite.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Keep payroll text out of external tracing platforms.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
